{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "react-router-postgres-web",
  "main": "./build/server/index.js",
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "compatibility_date": "2025-10-08",
