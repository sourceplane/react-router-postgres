# Local development only — the Worker never reads this file; its database is
# the HYPERDRIVE binding (wrangler.jsonc's localConnectionString locally, the
# Supabase CLI's default database at localhost:54322).
#
# The database `pnpm --filter @app/web db:migrate:local` applies packages/db's
# migrations to, when it is not the Supabase CLI's:
LOCAL_DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
