{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "wrangler dev --config wrangler.deploy.jsonc",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "wire:fixture": "node ../../tooling/wire/render.mjs --template wrangler.template.jsonc --out wrangler.jsonc --map wiring.fixture.json --env stage && node ../../tooling/wire/render.mjs --template wrangler.deploy.template.jsonc --out wrangler.deploy.jsonc --map wiring.fixture.json --env stage",
    "db:migrate:local": "node ../../tooling/migrations/local.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "isbot": "5.1.32",
    "match-sorter": "8.2.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-router": "7.9.6",
    "sort-by": "1.2.0",
    "tailwindcss": "4.1.17",
    "tiny-invariant": "1.3.3"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@cloudflare/vite-plugin": "1.52.1",
    "@cloudflare/workers-types": "^4.20250508.0",
    "@eslint/js": "^9.27.0",
    "@react-router/dev": "7.9.6",
    "@types/node": "^22.9.0",
    "autoprefixer": "10.4.22",
    "eslint": "^9.27.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.0.0",
    "hono": "4.11.1",
    "postgres": "3.4.7",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "wrangler": "4.136.1"
  }
}
